{
  "name": "personal-budget-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "vite",
    "dev:server": "node --env-file=.env server/index.mjs",
    "dev:all": "concurrently -k \"npm:dev:server\" \"npm:dev\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mysql2": "^3.14.1",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.1.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.8"
  }
}
